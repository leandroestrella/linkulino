# Copy to `.env.local` and fill in your own values (see the README).
# Both values are public — safe to expose in the client bundle — but are kept
# in env so you can point your own instance at your own backend without editing source.

# Apps Script web-app endpoint (ends in /exec)
VITE_API_URL=

# Google OAuth 2.0 Web client ID (for partner sign-in via Google Identity Services)
VITE_GOOGLE_CLIENT_ID=
