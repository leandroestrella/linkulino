# dependencies
node_modules/

# build output
web/dist/
dist/

# environment files
# (public config is read from VITE_* env vars; put your own values in
#  web/.env.local, which is ignored below)
.env
.env.*
!.env.example

# clasp — personal deployment config & credentials
# (.clasp.json holds your own scriptId; cloners create theirs from .clasp.example.json)
apps-script/.clasp.json
apps-script/.clasp.dev.json
apps-script/.clasp.prod.json
.clasprc.json

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# test coverage
coverage/

# caches
.vite/
.eslintcache
*.tsbuildinfo

# editors & IDEs
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
.DS_Store
Thumbs.db

# temp files
.temp/

# Claude Code — local AI-assistant files, not part of the public template
.claude/
CLAUDE.md

# Internal design doc — kept locally, not published
PLAN.md
